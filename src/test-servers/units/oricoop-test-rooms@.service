# T-155: TEST instance (not production). %i = slot 0-3; ports come from /etc/oricoop/test-%i.env,
# written by src/test-servers/remote-deploy.sh (slot N: rooms TCP 47101+10N).
[Unit]
Description=OriCoop TEST room saves (HTTP), slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/oricoop/test-%i.env
StateDirectory=oricoop-test-rooms-%i
LogsDirectory=oricoop-test-rooms-%i
WorkingDirectory=/opt/oricoop/test/%i/rooms
ExecStart=/opt/oricoop/dotnet/dotnet /opt/oricoop/test/%i/rooms/RoomServer.dll --port ${ROOMS_PORT} --data /var/lib/oricoop-test-rooms-%i
Environment=DOTNET_ROOT=/opt/oricoop/dotnet
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_gcServer=0
Restart=always
RestartSec=3
# Test instances must never starve the production services on the same machine.
Nice=10
CPUWeight=20
MemoryMax=192M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
